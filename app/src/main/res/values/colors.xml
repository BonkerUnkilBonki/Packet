<?xml version="1.0" encoding="utf-8"?>
<!--
  One UI Quick Share palette (fork).

  Every token name from upstream is preserved so no layout or Kotlin reference breaks; only the
  values are retuned to Samsung's Quick Share look: a soft pale-blue page, pure white floating
  cards and pills, and a bright Quick Share blue accent.
-->
<resources>
    <color name="ic_launcher_background">#1B8FF0</color>

    <!-- Accent: Quick Share blue. -->
    <color name="brand_primary">#1B8FF0</color>
    <color name="brand_on_primary">#FFFFFFFF</color>

    <!-- Bottom navigation -->
    <color name="nav_surface">#FFFFFFFF</color>
    <color name="nav_item_active">#1B8FF0</color>
    <color name="nav_item_inactive">#FF6B7480</color>
    <color name="nav_active_indicator">#1F1B8FF0</color>
    <color name="nav_pill_surface">#F2FFFFFF</color>

    <!-- Page and surfaces -->
    <color name="page_background">#EAF2FB</color>
    <color name="surface_floating">#FFFFFFFF</color>
    <color name="surface_card">#FFFFFFFF</color>
    <color name="surface_chip">#F1F5FA</color>
    <color name="surface_card_stroke">#14000000</color>
    <color name="surface_chip_stroke">#1A000000</color>

    <!-- Quick Share specific surfaces -->
    <color name="qs_gradient_top">#E8F3FE</color>
    <color name="qs_gradient_bottom">#F9FCFF</color>
    <color name="qs_pill">#FFFFFFFF</color>
    <color name="qs_pill_stroke">#14000000</color>
    <color name="qs_segment_active">#E9EEF4</color>
    <color name="qs_aura_inner">#D6ECFF</color>
    <color name="qs_aura_outer">#F2F9FF</color>

    <!-- Pills are solid white with a hairline, per Quick Share -->
    <color name="frosted_button_fill">#FFFFFFFF</color>
    <color name="frosted_button_stroke">#1A0B1A2A</color>
    <color name="frosted_button_disabled">#66FFFFFF</color>
    <color name="frosted_button_ripple">#1F1B8FF0</color>
    <color name="frosted_button_pressed">#2B1B8FF0</color>

    <color name="popup_menu_surface">#FFFFFFFF</color>

    <color name="card_dialog_gradient_top">#E9F4FF</color>
    <color name="card_dialog_gradient_bottom">#DCE9F8</color>

    <color name="pin_state_gradient_inner">#F2FAFF</color>
    <color name="pin_state_gradient_outer">#CBE3F7</color>

    <color name="bottom_sheet_drag_handle">#5F000000</color>
    <color name="rejection_banner_bg">#CC323232</color>
    <color name="card_blur_overlay">#80FFFFFF</color>
    <color name="credit_avatar_stroke">#1F000000</color>

    <color name="update_badge_red">#FFE53935</color>

    <color name="radio_banner_fill">#0A1B8FF0</color>
    <color name="radio_banner_stroke">#1F1B8FF0</color>
    <color name="master_on_fill">#1A1B8FF0</color>
    <color name="master_on_stroke">#331B8FF0</color>
</resources>
