<?xml version="1.0" encoding="utf-8"?>
<!--
  ConsentTrampolineActivity layout — One UI Quick Share receive panel (fork, rebuilt).

  This is a structural rebuild, not a re-skin: the receive prompt is now the Quick Share
  component set — a drag handle, a circular accent file badge, a centred title, a PIN chip,
  and a pair of One UI pill actions (Decline outline / Accept filled accent) over the radial
  Quick Share glow.

  Every view id the activity looks up is preserved, with the same view types it casts to:
    consent_sheet -> DraggableSheetLayout, consent_receiving_progress -> RoundedProgressBar,
    consent_card_blur / consent_completed_preview -> ImageView,
    consent_completed_preview_card -> FrameLayout, consent_files_list -> LinearLayout,
    accept / reject / failed-close -> Button, the rest -> View / TextView.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/consent_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/consent_sheet_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <dev.bluehouse.bada.ui.sheet.DraggableSheetLayout
        android:id="@+id/consent_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/send_sheet_background"
        android:clipToPadding="false">

        <ScrollView
            android:id="@+id/consent_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="false">

            <FrameLayout
                android:id="@+id/consent_card_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="440dp"
                android:paddingBottom="20dp">

                <!-- Quick Share radial glow behind the prompt. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_qs_aura" />

                <!-- Blurred photo backdrop; enabled by the activity on completion only. -->
                <ImageView
                    android:id="@+id/consent_card_blur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <View
                    android:id="@+id/consent_card_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/card_blur_overlay"
                    android:visibility="gone" />

                <!-- ================= Consent state ================= -->
                <LinearLayout
                    android:id="@+id/consent_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp">

                    <!-- Drag handle. -->
                    <View
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bottom_sheet_drag_handle" />

                    <!-- Circular file-type badge. -->
                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_qs_badge">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_file_24" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/consent_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/consent_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/consent_pin_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/consent_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_qs_chip"
                        android:paddingStart="16dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/brand_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/consent_files_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/consent_files_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <!-- Quick Share action row: Decline outline + Accept filled accent. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/consent_reject_button"
                            style="@style/Widget.Bada.Button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/consent_button_reject" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="wrap_content" />

                        <Button
                            android:id="@+id/consent_accept_button"
                            style="@style/Widget.Bada.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/consent_button_accept" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ================= Waiting state ================= -->
                <LinearLayout
                    android:id="@+id/consent_waiting_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginBottom="26dp"
                        android:background="@drawable/bottom_sheet_drag_handle" />

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_qs_badge">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_send_receive_24" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/consent_state_waiting_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/consent_state_waiting_body"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- ================= Receiving state ================= -->
                <LinearLayout
                    android:id="@+id/consent_receiving_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bottom_sheet_drag_handle" />

                    <TextView
                        android:id="@+id/consent_receiving_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/consent_receiving_progress_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:textColor="@color/brand_primary"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <dev.bluehouse.bada.ui.sheet.RoundedProgressBar
                        android:id="@+id/consent_receiving_progress"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:id="@+id/consent_receiving_progress_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/consent_expert_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- ================= Completed state ================= -->
                <LinearLayout
                    android:id="@+id/consent_completed_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bottom_sheet_drag_handle" />

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_qs_badge">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_file_24" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/consent_completed_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/consent_completed_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/consent_completed_preview_card"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/photo_card_background"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/consent_completed_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/consent_completed_close_button"
                            style="@style/Widget.Bada.Button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/consent_state_close" />

                        <Space
                            android:id="@+id/consent_completed_button_gap"
                            android:layout_width="12dp"
                            android:layout_height="wrap_content" />

                        <Button
                            android:id="@+id/consent_completed_view_button"
                            style="@style/Widget.Bada.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/consent_state_view_image" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ================= Failed state ================= -->
                <LinearLayout
                    android:id="@+id/consent_failed_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bottom_sheet_drag_handle" />

                    <TextView
                        android:id="@+id/consent_failed_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/consent_failed_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/consent_failed_close_button"
                        style="@style/Widget.Bada.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp"
                        android:text="@string/consent_state_close" />

                </LinearLayout>

            </FrameLayout>

        </ScrollView>

    </dev.bluehouse.bada.ui.sheet.DraggableSheetLayout>

</FrameLayout>
