<?xml version="1.0" encoding="utf-8"?>
<!--
  Send / Receive tab — One UI Quick Share presentation (fork).

  Same vertical order and every upstream view id as before, restyled to the Quick Share look:
  a white rounded banner card, a pill visibility button, a centred "ready to receive" caption over
  the polaroid preview pair, and a pair of pill action buttons at the bottom.

  Ids preserved: main_legacy_wvmg_banner{,_title,_body,_uninstall}, main_always_visible_button,
  main_always_visible_caption, main_send_waiting, main_send_preview_photo_1,
  main_send_preview_photo_2, main_send_files_button, main_send_folder_button.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Legacy-install migration banner (#145). Hidden by default. -->
        <LinearLayout
            android:id="@+id/main_legacy_wvmg_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/settings_card_background"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/main_legacy_wvmg_banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_legacy_wvmg_banner_title"
                android:textAppearance="@style/TextAppearance.AppCompat.Title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_legacy_wvmg_banner_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/main_legacy_wvmg_banner_body"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/main_legacy_wvmg_banner_uninstall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_legacy_wvmg_banner_uninstall" />

            </LinearLayout>

        </LinearLayout>

        <!-- Always-visible pill (#34). -->
        <Button
            android:id="@+id/main_always_visible_button"
            style="@style/Widget.Bada.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/main_always_visible_off_title" />

        <TextView
            android:id="@+id/main_always_visible_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/main_always_visible_caption_off"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hero: centred status line + polaroid preview pair. -->
        <TextView
            android:id="@+id/main_send_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/main_send_waiting"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/main_send_preview_photo_1"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_send_preview_photo_description"
                android:scaleType="fitCenter"
                android:translationX="-32dp" />

            <ImageView
                android:id="@+id/main_send_preview_photo_2"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_send_preview_photo_description"
                android:scaleType="fitCenter"
                android:translationX="32dp" />

        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Send actions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/main_send_files_button"
                style="@style/Widget.Bada.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/main_send_files_button" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/main_send_folder_button"
                style="@style/Widget.Bada.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/main_send_folder_button" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
