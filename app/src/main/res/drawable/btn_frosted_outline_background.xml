<?xml version="1.0" encoding="utf-8"?>
<!-- One UI Quick Share secondary pill: solid surface with a slightly stronger hairline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/frosted_button_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="@color/frosted_button_stroke" />
        </shape>
    </item>
</ripple>
